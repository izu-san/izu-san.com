---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.png';
import Base from '../layouts/Base.astro';
import ExtLink from './ExtLink.astro';
import FactoryPuzzle from './FactoryPuzzle.astro';
import { loadSiteContent } from '../lib/content.ts';
import { otherLang, paths, sectionIds, ui, type Lang } from '../lib/i18n.ts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const other = otherLang(lang);
const { profile, works, skills, career, status, links } = await loadSiteContent(lang);
const { Content } = profile;
const tokenFor = (word: string) => profile.data.tokens?.find((tk) => tk.word === word);
---

<Base lang={lang} title={profile.data.pageTitle} description={profile.data.description}>
  <a class="skip-link" href="#main">{t.skip}</a>

  <header class="site-header">
    <div class="wrap">
      <p class="site-name">{profile.data.name}</p>
      <nav class="site-nav" aria-label={t.navLabel}>
        <ul>
          {sectionIds.map((id) => <li><a href={`#${id}`}>{t.nav[id]}</a></li>)}
        </ul>
      </nav>
      <p class="lang-switch">
        {t.switchLabel}:
        <a id="lang-switch" href={paths[other]} hreflang={other} lang={other}>{t.switchText}</a>
      </p>
    </div>
  </header>

  <main id="main">
    <section id="profile" class="hero" aria-labelledby="profile-h">
      <div class="wrap">
        <div class="titleblock">
          <p class="tb-label" aria-hidden="true"><span>DWG-001</span><span>REV A</span></p>
          <div class="tb-body">
            <Image
              class="avatar"
              src={avatar}
              alt={profile.data.avatarAlt}
              widths={[96, 192]}
              sizes="96px"
              width={96}
              height={96}
              format="webp"
              loading="eager"
            />
            <div class="name-dim">
              <h1 id="profile-h">{profile.data.name}</h1>
              <div class="dim" aria-hidden="true"><span>1:1</span></div>
            </div>
            <p class="headline">{profile.data.headline}</p>
            <ol class="notes">
              {profile.data.interests.map((i) => {
                const token = tokenFor(i);
                return (
                  <li>
                    {token ? (
                      <details class="token">
                        <summary>{i}</summary>
                        <div class="token-pop">
                          <p class="token-label">{t.token.label}</p>
                          <ul>
                            {token.candidates.map((c) => (
                              <li><span>{c.text}</span><span>{c.p.toFixed(2)}</span></li>
                            ))}
                          </ul>
                        </div>
                      </details>
                    ) : (
                      i
                    )}
                  </li>
                );
              })}
            </ol>
            <div class="prose">
              <Content />
            </div>
            <section class="status" aria-labelledby="status-h">
              <h2 id="status-h" class="status-title">{t.status.title}</h2>
              <dl>
                {status.items.map((item) => (
                  <div class={`status-row status-${item.kind}`}>
                    <dt>{t.status.kinds[item.kind]}</dt>
                    <dd>{item.text}</dd>
                  </div>
                ))}
              </dl>
              <p class="status-updated">{t.status.updated}: <time datetime={status.updated}>{status.updated}</time></p>
            </section>
          </div>
          <p class="tb-label" aria-hidden="true"><span>SCALE 1:1</span><span>SHEET 1/1</span></p>
        </div>
      </div>
    </section>

    <section id="works" class="section" aria-labelledby="works-h">
      <div class="wrap">
        <h2 id="works-h" class="section-title">{t.nav.works}</h2>
        <ul class="panels">
          {works.map((w, i) => (
            <li class="panel reveal" style={`--i: ${i}`}>
              <h3 class="panel-title">
                {w.url ? <ExtLink class="panel-link" href={w.url} lang={lang}>{w.copy.name}</ExtLink> : w.copy.name}
              </h3>
              <p class="panel-body">{w.copy.summary}</p>
              <div class="recipe">
                <p class="sr-only">{t.tech}:</p>
                <ul class="recipe-in">
                  {w.tech.map((name) => <li>{name}</li>)}
                </ul>
                <span class="recipe-arrow" aria-hidden="true">→</span>
                <span class="recipe-out" aria-hidden="true">PART {String(i + 1).padStart(2, '0')}</span>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="skills" class="section" aria-labelledby="skills-h">
      <div class="wrap">
        <h2 id="skills-h" class="section-title">{t.nav.skills}</h2>
        <div class="rows">
          {skills.map((s) => (
            <div class="skill-group">
              <h3>{s.label}</h3>
              <dl class="skill-list">
                {s.items.map((i) => <><dt>{i.name}</dt><dd>{i.usage}</dd></>)}
              </dl>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="career" class="section" aria-labelledby="career-h">
      <div class="wrap">
        <h2 id="career-h" class="section-title">{t.nav.career}</h2>
        <div class="rows">
          {career.map((c) => (
            <article>
              <h3 class="row-title">{c.field}</h3>
              <p class="meta"><time>{c.start}</time> – {c.end ? <time>{c.end}</time> : t.present}</p>
              <p class="row-body">{c.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="contact" class="section" aria-labelledby="contact-h">
      <div class="wrap">
        <h2 id="contact-h" class="section-title">{t.nav.contact}</h2>
        <div>
          <dl class="approval">
            <div><dt>{t.approval.designed}</dt><dd>{profile.data.name}</dd></div>
            <div><dt>{t.approval.checked}</dt><dd>{t.approval.you}</dd></div>
            <div class="approval-open"><dt>{t.approval.approved}</dt><dd>{t.approval.open}</dd></div>
          </dl>
          <p class="approval-note">{t.approval.invite}</p>
          <ul class="panels panels-links">
            {links.map((l, i) => (
              <li class="panel reveal" style={`--i: ${i}`}>
                <h3 class="panel-title"><ExtLink class="panel-link" href={l.url} lang={lang}>{l.label}</ExtLink></h3>
                <p class="meta">{l.url.replace(/^(mailto:|https?:\/\/)/, '')}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <FactoryPuzzle lang={lang} links={links} />
      <p>{t.footer}</p>
    </div>
  </footer>

  <script>
    // 次トークン候補: 同時に開くのは 1 つだけ。外側のクリックと Escape で閉じる。
    const tokens = [...document.querySelectorAll<HTMLDetailsElement>('details.token')];
    for (const d of tokens) {
      d.addEventListener('toggle', () => {
        if (d.open) for (const o of tokens) if (o !== d) o.open = false;
      });
    }
    addEventListener('click', (e) => {
      for (const d of tokens) if (d.open && !d.contains(e.target as Node)) d.open = false;
    });
    addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      for (const d of tokens) {
        if (d.open) {
          d.open = false;
          d.querySelector('summary')?.focus();
        }
      }
    });

    // スクロールで現れる演出。動きを減らす設定のときは何もしない（CSS 側でも無効）。
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const targets = document.querySelectorAll('.section, .reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.15 },
        );
        targets.forEach((el) => io.observe(el));
      } else {
        targets.forEach((el) => el.classList.add('is-visible'));
      }
    }

    // JavaScript が使えるときだけ、切り替えリンクに現在のセクション（#...）を引き継ぐ。
    const link = document.querySelector<HTMLAnchorElement>('#lang-switch');
    if (link) {
      const base = link.getAttribute('href')!;
      const sync = () => link.setAttribute('href', base + location.hash);
      addEventListener('hashchange', sync);
      sync();
    }
  </script>
</Base>
