---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.png';
import Base from '../layouts/Base.astro';
import ExtLink from './ExtLink.astro';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';
import { loadSiteContent } from '../lib/content.ts';
import { otherLang, paths, ui, workPath, type Lang } from '../lib/i18n.ts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const other = otherLang(lang);
const { profile, works, skills, career, status, links } = await loadSiteContent(lang);
const { Content } = profile;
const tokenFor = (word: string) => profile.data.tokens?.find((tk) => tk.word === word);
---

<Base
  lang={lang}
  title={profile.data.pageTitle}
  description={profile.data.description}
  share={{
    name: profile.data.name,
    imageAlt: `${profile.data.name} — ${profile.data.headline}`,
    sameAs: links.filter((l) => l.url.startsWith('https://')).map((l) => l.url),
  }}
>
  <a class="skip-link" href="#main">{t.skip}</a>

  <SiteHeader lang={lang} name={profile.data.name} switchHref={paths[other]} />

  <main id="main">
    <section id="profile" class="hero" aria-labelledby="profile-h">
      <div class="wrap">
        <div class="titleblock">
          <p class="tb-label" aria-hidden="true"><span>DWG-001</span><span>REV A</span></p>
          <div class="tb-body">
            <Image
              class="avatar"
              src={avatar}
              alt={profile.data.avatarAlt}
              widths={[176, 288, 576]}
              sizes="(min-width: 48rem) 18rem, 11rem"
              width={288}
              height={288}
              format="webp"
              loading="eager"
            />
            <div class="name-dim">
              <h1 id="profile-h">{profile.data.name}</h1>
              <div class="dim" aria-hidden="true"><span>1:1</span></div>
            </div>
            <p class="headline">{profile.data.headline}</p>
            <ol class="notes">
              {profile.data.interests.map((i) => {
                const token = tokenFor(i);
                return (
                  <li>
                    {token ? (
                      <details class="token">
                        <summary>{i}</summary>
                        <div class="token-pop">
                          <p class="token-label">{t.token.label}</p>
                          <ul>
                            {token.candidates.map((c) => (
                              <li><span>{c.text}</span><span>{c.p.toFixed(2)}</span></li>
                            ))}
                          </ul>
                        </div>
                      </details>
                    ) : (
                      i
                    )}
                  </li>
                );
              })}
            </ol>
            <div class="prose">
              <Content />
            </div>
            <section class="status" aria-labelledby="status-h">
              <h2 id="status-h" class="status-title">{t.status.title}</h2>
              <dl>
                {status.items.map((item) => (
                  <div class={`status-row status-${item.kind}`}>
                    <dt>{t.status.kinds[item.kind]}</dt>
                    <dd>{item.text}</dd>
                  </div>
                ))}
              </dl>
              <p class="status-updated">{t.status.updated}: <time datetime={status.updated}>{status.updated}</time></p>
            </section>
          </div>
          <p class="tb-label" aria-hidden="true"><span>SCALE 1:1</span><span>SHEET 1/1</span></p>
        </div>
      </div>
    </section>

    <section id="works" class="section" aria-labelledby="works-h">
      <div class="wrap">
        <h2 id="works-h" class="section-title">{t.nav.works}</h2>
        <ul class="panels">
          {works.map((w, i) => (
            <li class="panel reveal" style={`--i: ${i}`}>
              <h3 class="panel-title">
                {w.url ? (
                  <ExtLink class="panel-link" href={w.url} lang={lang}>{w.copy.name}</ExtLink>
                ) : (
                  <a class="panel-link" href={workPath(lang, w.id)}>{w.copy.name}<span class="sr-only"> — {t.work.more}</span></a>
                )}
              </h3>
              <p class="panel-body">{w.copy.summary}</p>
              <div class="recipe">
                <p class="sr-only">{t.tech}:</p>
                <ul class="recipe-in">
                  {w.tech.map((name) => <li>{name}</li>)}
                </ul>
                <span class="recipe-arrow" aria-hidden="true">→</span>
                <span class="recipe-out" aria-hidden="true">PART {String(i + 1).padStart(2, '0')}</span>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="skills" class="section" aria-labelledby="skills-h">
      <div class="wrap">
        <h2 id="skills-h" class="section-title">{t.nav.skills}</h2>
        <div class="rows">
          {skills.map((s) => (
            <div class="skill-group">
              <h3>{s.label}</h3>
              <dl class="skill-list">
                {s.items.map((i) => <><dt>{i.name}</dt><dd>{i.usage}</dd></>)}
              </dl>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="career" class="section" aria-labelledby="career-h">
      <div class="wrap">
        <h2 id="career-h" class="section-title">{t.nav.career}</h2>
        <div class="rows">
          {career.map((c) => (
            <article>
              <h3 class="row-title">{c.field}</h3>
              <p class="meta"><time>{c.start}</time> – {c.end ? <time>{c.end}</time> : t.present}</p>
              <p class="row-body">{c.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="contact" class="section" aria-labelledby="contact-h">
      <div class="wrap">
        <h2 id="contact-h" class="section-title">{t.nav.contact}</h2>
        <div>
          <dl class="approval">
            <div><dt>{t.approval.designed}</dt><dd>{profile.data.name}</dd></div>
            <div><dt>{t.approval.checked}</dt><dd>{t.approval.you}</dd></div>
            <div class="approval-open"><dt>{t.approval.approved}</dt><dd>{t.approval.open}</dd></div>
          </dl>
          <p class="approval-note">{t.approval.invite}</p>
          <ul class="panels panels-links" data-copy-label={t.copy.label} data-copy-done={t.copy.done} data-copy-aria={t.copy.aria}>
            {links.map((l, i) => (
              <li class="panel reveal" style={`--i: ${i}`}>
                <h3 class="panel-title"><ExtLink class="panel-link" href={l.url} lang={lang}>{l.label}</ExtLink></h3>
                <p class="meta">{l.url.replace(/^(mailto:|https?:\/\/)/, '')}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter lang={lang} links={links} />

  <script>
    // 次トークン候補: 同時に開くのは 1 つだけ。外側のクリックと Escape で閉じる。
    const tokens = [...document.querySelectorAll<HTMLDetailsElement>('details.token')];
    for (const d of tokens) {
      d.addEventListener('toggle', () => {
        if (d.open) for (const o of tokens) if (o !== d) o.open = false;
      });
    }
    addEventListener('click', (e) => {
      for (const d of tokens) if (d.open && !d.contains(e.target as Node)) d.open = false;
    });
    addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      for (const d of tokens) {
        if (d.open) {
          d.open = false;
          d.querySelector('summary')?.focus();
        }
      }
    });

    // スクロールで現れる演出。動きを減らす設定のときは何もしない（CSS 側でも無効）。
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const targets = document.querySelectorAll('.section, .reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.15 },
        );
        targets.forEach((el) => io.observe(el));
      } else {
        targets.forEach((el) => el.classList.add('is-visible'));
      }
    }

    // メールアドレスのコピー（Clipboard API が使えるときだけボタンを足す。mailto: のリンクはそのまま残す）。
    const contactList = document.querySelector<HTMLElement>('.panels-links');
    if (contactList && navigator.clipboard) {
      const { copyLabel = '', copyDone = '', copyAria = '' } = contactList.dataset;
      for (const panel of contactList.querySelectorAll<HTMLElement>('.panel')) {
        const mail = panel.querySelector<HTMLAnchorElement>('a[href^="mailto:"]');
        if (!mail) continue;
        const address = mail.getAttribute('href')!.slice('mailto:'.length);
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'copy-button';
        button.textContent = copyLabel;
        button.setAttribute('aria-label', `${copyAria}: ${address}`);
        const status = document.createElement('span');
        status.className = 'copy-status';
        status.setAttribute('role', 'status');
        let timer: number | undefined;
        button.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(address);
            status.textContent = copyDone;
            clearTimeout(timer);
            timer = window.setTimeout(() => (status.textContent = ''), 2500);
          } catch {
            status.textContent = '';
          }
        });
        // ボタンと結果を同じ行に置く（結果が空でもカードの高さが変わらない）。
        const row = document.createElement('div');
        row.className = 'copy-row';
        row.append(button, status);
        panel.append(row);
      }
    }

    // 表示中のセクションをナビで示す（JavaScript が使えるときだけ）。
    // 末尾のセクションは短く、ページ下端まででは帯に届かないため、
    // 下端では最後の項目を現在とし、ナビを押したときは押した項目を現在とする。
    const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('.site-nav a[data-section]')];
    if (navLinks.length && 'IntersectionObserver' in window) {
      const visible = new Set<string>();
      let chosen: string | undefined;
      const atBottom = () => innerHeight + scrollY >= document.documentElement.scrollHeight - 2;
      const mark = () => {
        // 帯にかかっているセクションのうち、ページの下にある方を現在とする。
        const current =
          chosen ??
          (atBottom() ? navLinks.at(-1)?.dataset.section : navLinks.findLast((a) => visible.has(a.dataset.section!))?.dataset.section);
        for (const a of navLinks) {
          if (a.dataset.section === current) a.setAttribute('aria-current', 'location');
          else a.removeAttribute('aria-current');
        }
      };
      const spy = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) visible.add(e.target.id);
            else visible.delete(e.target.id);
          }
          mark();
        },
        { rootMargin: '-20% 0px -55% 0px' },
      );
      for (const a of navLinks) {
        const section = document.getElementById(a.dataset.section!);
        if (section) spy.observe(section);
        a.addEventListener('click', () => {
          chosen = a.dataset.section;
          mark();
        });
      }
      // 利用者が自分でスクロールしたら、押した項目の固定をやめる。
      const release = () => {
        if (chosen) {
          chosen = undefined;
          mark();
        }
      };
      for (const type of ['wheel', 'touchmove', 'keydown'] as const) addEventListener(type, release, { passive: true });
      addEventListener('scroll', mark, { passive: true });
    }

    // JavaScript が使えるときだけ、切り替えリンクに現在のセクション（#...）を引き継ぐ。
    const link = document.querySelector<HTMLAnchorElement>('#lang-switch');
    if (link) {
      const base = link.getAttribute('href')!;
      const sync = () => link.setAttribute('href', base + location.hash);
      addEventListener('hashchange', sync);
      sync();
    }
  </script>
</Base>
