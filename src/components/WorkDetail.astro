---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import ExtLink from './ExtLink.astro';
import { loadSiteContent } from '../lib/content.ts';
import { languages, otherLang, paths, ui, workPath, type Lang } from '../lib/i18n.ts';

interface Props {
  lang: Lang;
  id: string;
}

const { lang, id } = Astro.props;
const t = ui[lang];
const other = otherLang(lang);
const { profile, works } = await loadSiteContent(lang);
const work = works.find((w) => w.id === id)!;
const detail = work.copy.detail!;
const pagePaths = Object.fromEntries(languages.map((l) => [l, workPath(l, id)])) as Record<Lang, string>;
---

<Base
  lang={lang}
  title={`${work.copy.name} | ${profile.data.name}`}
  description={work.copy.summary}
  pagePaths={pagePaths}
  share={{ name: profile.data.name, imageAlt: `${profile.data.name} — ${profile.data.headline}` }}
>
  <a class="skip-link" href="#main">{ui[lang].skip}</a>

  <header class="site-header">
    <div class="wrap">
      <a class="site-brand" href={`${paths[lang]}#works`}>
        <span class="brand-mark" aria-hidden="true"></span>
        <span class="site-name">{profile.data.name}</span>
        <span class="brand-sub" aria-hidden="true">IZU-SAN / PORTFOLIO</span>
      </a>
      <p class="lang-switch" role="group" aria-label={t.switchLabel}>
        <span class="lang-current" lang={lang} aria-current="true">{lang.toUpperCase()}</span>
        <a id="lang-switch" href={pagePaths[other]} hreflang={other} lang={other} aria-label={t.switchText}>{other.toUpperCase()}</a>
      </p>
    </div>
  </header>

  <main id="main" class="work-detail">
    <div class="wrap">
      <p class="work-crumb"><a href={`${paths[lang]}#works`}>← {t.work.back}</a></p>
      <header class="work-hero">
        <div class="work-intro">
          <p class="section-title work-kicker">{t.work.navLabel}</p>
          <h1>{work.copy.name}</h1>
          <p class="work-lead">{detail.lead}</p>
          <div class="recipe">
            <p class="sr-only">{t.tech}:</p>
            <ul class="recipe-in">
              {work.tech.map((name) => <li>{name}</li>)}
            </ul>
          </div>
        </div>
        {work.image && (
          <figure class="work-figure">
            <Image
              src={work.image as ImageMetadata}
              alt={work.copy.imageAlt!}
              widths={[288, 576]}
              sizes="(min-width: 48rem) 18rem, 100vw"
              width={288}
              format="webp"
              loading="eager"
            />
            {work.copy.imageCredit && (
              <figcaption class="work-credit">
                {work.copy.imageCredit.text}
                {work.copy.imageCredit.link && (
                  <> <ExtLink href={work.copy.imageCredit.link.url} lang={lang}>{work.copy.imageCredit.link.label}</ExtLink></>
                )}
              </figcaption>
            )}
          </figure>
        )}
      </header>

      {detail.sections.map((section, i) => (
        <section class="work-section" aria-labelledby={`sec-${i}`}>
          <h2 id={`sec-${i}`}><span class="work-sec-no" aria-hidden="true">SEC.{String(i + 1).padStart(2, '0')}</span>{section.heading}</h2>
          {section.body?.map((paragraph) => <p>{paragraph}</p>)}
          {section.diagram && (
            <figure class="diagram">
              <ol class="diagram-rows">
                {section.diagram.rows.map((row) => (
                  <li class="diagram-row">
                    <p class="diagram-label">{row.label}</p>
                    <ul class="diagram-nodes">
                      {row.nodes.map((node) => (
                        <li class="diagram-node">
                          <span class="diagram-name">{node.name}</span>
                          {node.note && <span class="diagram-note">{node.note}</span>}
                        </li>
                      ))}
                    </ul>
                  </li>
                ))}
              </ol>
              <figcaption>{section.diagram.caption}</figcaption>
            </figure>
          )}
          {section.points && (
            <dl class="work-points">
              {section.points.map((point) => <><dt>{point.label}</dt><dd>{point.text}</dd></>)}
            </dl>
          )}
        </section>
      ))}
    </div>
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <p><a href={`${paths[lang]}#works`}>{t.work.back}</a></p>
      <p>{t.footer}</p>
    </div>
  </footer>
</Base>
