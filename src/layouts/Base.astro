---
import { languages, paths, type Lang } from '../lib/i18n.ts';

interface Props {
  lang: Lang;
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;
const url = (l: Lang) => new URL(paths[l], Astro.site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url(lang)} />
    {languages.map((l) => <link rel="alternate" hreflang={l} href={url(l)} />)}
    <link rel="alternate" hreflang="x-default" href={url('ja')} />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
  }
  body {
    margin: 0 auto;
    max-width: 48rem;
    padding: 1rem;
    line-height: 1.7;
    background: #111;
    color: #eee;
    font-family: system-ui, sans-serif;
  }
  a {
    color: #8cf;
  }
</style>
